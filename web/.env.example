# Resend – Versand des Kontaktformulars.
# Die Domain thomato.ch muss in Resend verifiziert sein (DNS-Records),
# sonst schlägt der Versand von noreply@thomato.ch fehl.
RESEND_API_KEY=

# Google Analytics 4 Measurement ID, Format G-XXXXXXXXXX.
# Solange leer, wird kein Analytics-Script geladen – auch nicht mit Einwilligung.
# Das Script lädt ausschliesslich nach aktiver Zustimmung im Cookie-Banner.
NEXT_PUBLIC_GA_ID=
